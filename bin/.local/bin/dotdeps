#!/usr/bin/env python3
"""dotdeps — dotfiles dependency dashboard (lazygit-style TUI)"""

import curses
import os
import re
import shlex
import subprocess
import sys
import threading
from datetime import datetime

# ── Repo / catalog detection ──────────────────────────────────────────────────

def _find_root(start: str):
    d = os.path.realpath(start)
    while d != "/":
        if os.path.isdir(os.path.join(d, ".git")):
            return d
        d = os.path.dirname(d)
    return None

SCRIPT_PATH = os.path.realpath(__file__)
ROOT_DIR    = _find_root(os.path.dirname(SCRIPT_PATH)) or ""
HOME_DIR    = os.path.expanduser("~")
LOG_DIR     = os.path.join(HOME_DIR, ".config", "dotdeps", "logs")


def _find_catalog(root: str) -> str:
    for c in [
        os.path.join(HOME_DIR, ".config", "dotdeps", "catalog.sh"),
        os.path.join(root, "dotdeps", ".config", "dotdeps", "catalog.sh"),
        os.path.join(root, "deps", "catalog.sh"),
    ]:
        if os.path.isfile(c):
            return c
    return ""


CATALOG = _find_catalog(ROOT_DIR)


def _get_distro() -> str:
    try:
        r = subprocess.run(
            ["bash", "-c", ". /etc/os-release && printf '%s' \"$ID\""],
            capture_output=True, text=True, timeout=5,
        )
        return r.stdout.strip() or "unknown"
    except Exception:
        return "unknown"

DISTRO = _get_distro()

# ── Logging ───────────────────────────────────────────────────────────────────

def _new_log_path(action: str) -> str:
    os.makedirs(LOG_DIR, exist_ok=True)
    ts  = datetime.now().strftime("%Y-%m-%d_%H-%M-%S")
    tag = action.replace(" ", "_").replace("/", "_")[:40]
    return os.path.join(LOG_DIR, f"{ts}_{tag}.log")

# ── Bash bridge ───────────────────────────────────────────────────────────────

_PREAMBLE = (
    f"ROOT_DIR={shlex.quote(ROOT_DIR)} "
    f"HOME_DIR={shlex.quote(HOME_DIR)} "
    f"DISTRO={shlex.quote(DISTRO)} "
    f"source {shlex.quote(CATALOG)} 2>/dev/null; "
)


def _bash(cmd: str) -> str:
    try:
        r = subprocess.run(
            ["bash", "-c", _PREAMBLE + cmd],
            capture_output=True, text=True, timeout=60,
        )
        return r.stdout.strip()
    except Exception as e:
        return f"error: {e}"


def _bash_stream(cmd: str, log_fn, log_path: str = "") -> int:
    lf = None
    try:
        proc = subprocess.Popen(
            ["bash", "-c", _PREAMBLE + cmd],
            stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True,
        )
        if log_path:
            lf = open(log_path, "w")
            lf.write(f"# cmd: {cmd}\n# distro: {DISTRO}\n# root: {ROOT_DIR}\n\n")
        for line in proc.stdout:
            line = line.rstrip()
            log_fn(line)
            if lf:
                lf.write(line + "\n")
                lf.flush()
        proc.wait()
        if lf:
            lf.write(f"\n# exit: {proc.returncode}\n")
        return proc.returncode
    except Exception as e:
        log_fn(f"error: {e}")
        return 1
    finally:
        if lf:
            lf.close()

# ── Data fetchers ─────────────────────────────────────────────────────────────

def fetch_categories():
    cats = []
    for line in _bash("dep_list_categories").splitlines():
        parts = line.split("\t")
        if len(parts) >= 3:
            cats.append({"id": parts[0], "label": parts[1], "counts": parts[2]})
    return cats


def fetch_items(cat_id: str):
    items = []
    for line in _bash(f"dep_list_items {shlex.quote(cat_id)}").splitlines():
        parts = line.split("\t")
        if len(parts) >= 3:
            items.append({
                "id":     parts[0],
                "label":  parts[1],
                "status": parts[2],
                "note":   parts[3] if len(parts) > 3 else "",
            })
    return items


def fetch_details(item_id: str) -> str:
    return _bash(f"dep_render_item {shlex.quote(item_id)}")


def fetch_raw_item(item_id: str) -> dict:
    raw   = _bash(f"dep_raw_item {shlex.quote(item_id)}")
    parts = raw.split("\t")
    keys  = ["label", "kind", "check", "install", "note", "cat"]
    return {k: (parts[i] if i < len(parts) else "") for i, k in enumerate(keys)}


def fetch_raw_category(cat_id: str) -> dict:
    raw   = _bash(f"dep_raw_category {shlex.quote(cat_id)}")
    parts = raw.split("\t")
    return {"label": parts[0] if parts else "", "stow": parts[1] if len(parts) > 1 else ""}

# ── Catalog file editor ───────────────────────────────────────────────────────

def _q(s: str) -> str:
    """Quote a value for use in catalog.sh — prefer single quotes for readability."""
    if not s:
        return '""'
    if re.match(r'^[a-zA-Z0-9_./@:+-]+$', s):
        return f'"{s}"'
    if "'" not in s:
        return f"'{s}'"
    return shlex.quote(s)


def _make_dep_line(cat_id, dep_id, label, kind, check, install, note) -> str:
    return (
        f"register_dep {cat_id} {dep_id} {_q(label)} {kind} "
        f"{_q(check)} {_q(install)} {_q(note)}\n"
    )


def _make_cat_line(cat_id, label, stow) -> str:
    return f"register_category {cat_id} {_q(label)} {_q(stow)}\n"


def _catalog_lines() -> list:
    with open(CATALOG) as f:
        return f.readlines()


def _catalog_write(lines: list):
    with open(CATALOG, "w") as f:
        f.writelines(lines)


def _catalog_find_dep(cat_id: str, dep_id: str) -> int:
    pat = re.compile(rf"^\s*register_dep\s+{re.escape(cat_id)}\s+{re.escape(dep_id)}\s+")
    for i, line in enumerate(_catalog_lines()):
        if pat.match(line):
            return i
    return -1


def _catalog_find_cat(cat_id: str) -> int:
    pat = re.compile(rf"^\s*register_category\s+{re.escape(cat_id)}\s+")
    for i, line in enumerate(_catalog_lines()):
        if pat.match(line):
            return i
    return -1


def _catalog_replace(idx: int, new_line: str):
    lines = _catalog_lines()
    lines[idx] = new_line
    _catalog_write(lines)


def _catalog_delete_dep(cat_id: str, dep_id: str):
    pat = re.compile(rf"^\s*register_dep\s+{re.escape(cat_id)}\s+{re.escape(dep_id)}\s+")
    lines = [l for l in _catalog_lines() if not pat.match(l)]
    _catalog_write(lines)


def _catalog_delete_cat(cat_id: str):
    cat_pat = re.compile(rf"^\s*register_category\s+{re.escape(cat_id)}\s+")
    dep_pat = re.compile(rf"^\s*register_dep\s+{re.escape(cat_id)}\s+")
    lines = [l for l in _catalog_lines() if not cat_pat.match(l) and not dep_pat.match(l)]
    _catalog_write(lines)


def _catalog_append(text: str):
    with open(CATALOG, "a") as f:
        f.write(text)

# ── Stow check (pre-curses) ───────────────────────────────────────────────────

def _pre_flight():
    checks = [
        (
            os.path.join(HOME_DIR, ".local", "bin", "dotdeps"),
            "bin",
            "bin package not stowed",
        ),
        (
            os.path.join(HOME_DIR, ".config", "dotdeps", "catalog.sh"),
            "dotdeps",
            "dotdeps package not stowed",
        ),
    ]
    for path, pkg, reason in checks:
        if not os.path.islink(path):
            print(f"\n  dotdeps: {path} is not a symlink ({reason})")
            try:
                resp = input(f"  Stow the '{pkg}' package now? [Y/n] ").strip().lower()
            except (EOFError, KeyboardInterrupt):
                resp = "n"
            if resp in ("", "y", "yes"):
                rc = subprocess.run(
                    ["stow", "-d", ROOT_DIR, "-t", HOME_DIR, "-R", pkg],
                ).returncode
                print(f"  {'✓ Done' if rc == 0 else '✗ Failed — continuing anyway'}")
                input("  Press Enter to continue…")

# ── Color pairs ───────────────────────────────────────────────────────────────

C_NORMAL = 0
C_GREEN  = 1
C_RED    = 2
C_YELLOW = 3
C_CYAN   = 4
C_SEL    = 5
C_BORDER = 6

# ── Modal (inline form / confirm) ─────────────────────────────────────────────

# Field spec: (label, key, hint)
# hint = ""              → plain text input
# hint = "hint text"     → shows hint in grey next to label
# hint = "choice:a|b|c"  → cycle with space/left/right, type first letter

class Modal:
    """Blocking inline curses form. Call run() → dict or None."""

    def __init__(self, scr, title: str, fields: list, defaults: dict = None):
        self.scr    = scr
        self.title  = title
        self.fields = fields
        self.vals   = {f[1]: (defaults or {}).get(f[1], "") for f in fields}
        self.idx    = 0

    def run(self) -> dict | None:
        curses.curs_set(1)
        result = None
        try:
            while True:
                self._draw()
                key = self.scr.getch()
                done, ok = self._handle(key)
                if done:
                    result = self.vals if ok else None
                    break
        finally:
            curses.curs_set(0)
        return result

    def _draw(self):
        H, W = self.scr.getmaxyx()
        n      = len(self.fields)
        form_h = n * 3 + 5
        form_w = min(W - 4, 74)
        y0     = max(1, (H - form_h) // 2)
        x0     = max(1, (W - form_w) // 2)

        win = curses.newwin(form_h, form_w, y0, x0)
        win.erase()
        bc = curses.color_pair(C_BORDER)
        win.attron(bc); win.box(); win.attroff(bc)
        win.addstr(0, 2, f" {self.title} ", bc | curses.A_BOLD)

        field_w = form_w - 4

        for i, (label, key, hint) in enumerate(self.fields):
            row = i * 3 + 1
            sel = i == self.idx
            val = self.vals[key]

            lab_attr = (curses.color_pair(C_CYAN) | curses.A_BOLD) if sel else curses.color_pair(C_CYAN)

            if hint.startswith("choice:"):
                choices = hint[7:].split("|")
                parts   = [f"[{c}]" if c == val else c for c in choices]
                lab_txt = f"{label}:  " + "  ".join(parts)
                try:
                    win.addstr(row, 2, lab_txt[:field_w], lab_attr)
                except curses.error:
                    pass
                # Value row shows selected option highlighted
                try:
                    win.addstr(row + 1, 2, val.ljust(field_w),
                               curses.color_pair(C_SEL) if sel else curses.color_pair(C_YELLOW))
                except curses.error:
                    pass
            else:
                lab_txt = f"{label}:"
                if hint:
                    lab_txt += f"  ({hint})"
                try:
                    win.addstr(row, 2, lab_txt[:field_w], lab_attr)
                except curses.error:
                    pass
                display = val[-(field_w):] if len(val) >= field_w else val
                val_attr = curses.color_pair(C_SEL) if sel else curses.A_UNDERLINE
                try:
                    win.addstr(row + 1, 2, display.ljust(field_w), val_attr)
                except curses.error:
                    pass
                if sel:
                    cx = min(len(display), field_w - 1)
                    try:
                        win.move(row + 1, 2 + cx)
                    except curses.error:
                        pass

        footer = " ↑/↓ · Tab next · Enter confirm · Esc cancel "
        try:
            win.addstr(form_h - 2, 2, footer[:form_w - 4], curses.color_pair(C_CYAN))
        except curses.error:
            pass
        win.refresh()

    def _handle(self, key):
        _, fkey, fhint = self.fields[self.idx]
        val = self.vals[fkey]

        if key == 27:  # Esc
            return True, False
        elif key in (curses.KEY_ENTER, 10, 13):
            if self.idx == len(self.fields) - 1:
                return True, True
            self.idx += 1
        elif key in (ord('\t'), curses.KEY_DOWN):
            self.idx = (self.idx + 1) % len(self.fields)
        elif key == curses.KEY_UP:
            self.idx = (self.idx - 1) % len(self.fields)
        elif key in (curses.KEY_BACKSPACE, 127, 8):
            self.vals[fkey] = val[:-1]
        elif fhint.startswith("choice:"):
            choices = fhint[7:].split("|")
            cur = choices.index(val) if val in choices else 0
            if key in (ord(' '), curses.KEY_RIGHT):
                self.vals[fkey] = choices[(cur + 1) % len(choices)]
            elif key == curses.KEY_LEFT:
                self.vals[fkey] = choices[(cur - 1) % len(choices)]
            elif 32 <= key <= 126:
                ch = chr(key).lower()
                for c in choices:
                    if c.lower().startswith(ch):
                        self.vals[fkey] = c
                        break
        elif 32 <= key <= 126:
            self.vals[fkey] = val + chr(key)

        return False, False


HELP = (
    " [j/k] nav  [tab] pane  [→/enter] items  [←/esc] back"
    "  [n] add  [e] edit  [d] delete  [i] install  [a] all  [s] stow  [r] refresh  [L] logs  [q] quit"
)

# ── App ───────────────────────────────────────────────────────────────────────

class App:
    def __init__(self, stdscr):
        self.scr  = stdscr
        self.lock = threading.Lock()

        self.cats     = []
        self.items    = []
        self.details  = ""
        self.loglines = []
        self.last_log = ""

        self.focus       = 0
        self.cat_sel     = 0
        self.cat_scroll  = 0
        self.item_sel    = 0
        self.item_scroll = 0

        self.status = "Loading…"
        self.busy   = False

        self._init_colors()
        self._layout()

    # ── layout ────────────────────────────────────────────────────────────────

    def _init_colors(self):
        curses.start_color()
        curses.use_default_colors()
        curses.init_pair(C_GREEN,  curses.COLOR_GREEN,  -1)
        curses.init_pair(C_RED,    curses.COLOR_RED,    -1)
        curses.init_pair(C_YELLOW, curses.COLOR_YELLOW, -1)
        curses.init_pair(C_CYAN,   curses.COLOR_CYAN,   -1)
        curses.init_pair(C_SEL,    curses.COLOR_BLACK,  curses.COLOR_WHITE)
        curses.init_pair(C_BORDER, curses.COLOR_CYAN,   -1)

    def _layout(self):
        H, W = self.scr.getmaxyx()
        left_w  = max(28, W // 3)
        right_w = W - left_w
        items_h = max(5, (H - 2) * 2 // 3)
        log_h   = max(3, H - 2 - items_h)

        self.w_cats  = curses.newwin(H - 2, left_w,   0,       0)
        self.w_items = curses.newwin(items_h, right_w, 0,       left_w)
        self.w_log   = curses.newwin(log_h,  right_w, items_h, left_w)
        self.w_bar   = curses.newwin(1, W,             H - 2,   0)
        self.w_help  = curses.newwin(1, W,             H - 1,   0)

    # ── draw helpers ─────────────────────────────────────────────────────────

    def _box(self, win, title="", active=False):
        win.erase()
        bc = curses.color_pair(C_BORDER if active else C_NORMAL)
        win.attron(bc); win.box(); win.attroff(bc)
        if title:
            win.addstr(0, 2, f" {title} ", bc | curses.A_BOLD)

    def _addstr(self, win, y, x, text, attr=0):
        try:
            win.addstr(y, x, text, attr)
        except curses.error:
            pass

    # ── draw panels ──────────────────────────────────────────────────────────

    def _draw_cats(self):
        active = self.focus == 0
        self._box(self.w_cats, "Categories", active)
        H, W = self.w_cats.getmaxyx()
        inner = H - 2

        with self.lock:
            cats = list(self.cats)

        n = len(cats)
        self.cat_sel = max(0, min(self.cat_sel, n - 1 if n else 0))
        if self.cat_sel < self.cat_scroll:
            self.cat_scroll = self.cat_sel
        elif n and self.cat_sel >= self.cat_scroll + inner:
            self.cat_scroll = self.cat_sel - inner + 1

        for i, cat in enumerate(cats[self.cat_scroll: self.cat_scroll + inner]):
            abs_i  = i + self.cat_scroll
            sel    = abs_i == self.cat_sel
            cursor = "▸ " if (active and sel) else "  "
            row    = f"{cursor}{cat['label']:<20} {cat['counts']:>5}"
            self._addstr(self.w_cats, i + 1, 1, row[:W - 2].ljust(W - 2),
                         curses.color_pair(C_SEL) if sel else 0)

        self.w_cats.noutrefresh()

    def _draw_items(self):
        active = self.focus == 1
        with self.lock:
            cats  = list(self.cats)
            items = list(self.items)

        cat_label = cats[self.cat_sel]["label"] if cats and 0 <= self.cat_sel < len(cats) else ""
        self._box(self.w_items, f"Items — {cat_label}", active)
        H, W = self.w_items.getmaxyx()
        inner = H - 2

        n = len(items)
        self.item_sel = max(0, min(self.item_sel, n - 1 if n else 0))
        if self.item_sel < self.item_scroll:
            self.item_scroll = self.item_sel
        elif n and self.item_sel >= self.item_scroll + inner:
            self.item_scroll = self.item_sel - inner + 1

        for i, item in enumerate(items[self.item_scroll: self.item_scroll + inner]):
            abs_i  = i + self.item_scroll
            ok     = item["status"] == "✓"
            icon   = "✓" if ok else "✗"
            icol   = curses.color_pair(C_GREEN) if ok else curses.color_pair(C_RED)
            sel    = abs_i == self.item_sel
            attr   = curses.color_pair(C_SEL) if sel else 0
            cursor = "▸" if (active and sel) else " "
            rest   = f"  {item['label'][:18]:<18}  {item['note'][:24]}"

            self._addstr(self.w_items, i + 1, 1, cursor, attr)
            self._addstr(self.w_items, i + 1, 2, icon + " ", icol | attr)
            self._addstr(self.w_items, i + 1, 4, rest[:W - 6], attr)

        self.w_items.noutrefresh()

    def _draw_log(self):
        with self.lock:
            loglines = list(self.loglines)
            details  = self.details
            last_log = self.last_log

        if loglines:
            log_ref = f" · {os.path.basename(last_log)}" if last_log else ""
            title   = f"Log{log_ref}"
        else:
            title = "Details"

        self._box(self.w_log, title)
        H, W = self.w_log.getmaxyx()
        inner = H - 2

        lines = loglines if loglines else details.splitlines()
        tail  = lines[-inner:] if len(lines) > inner else lines
        for i, line in enumerate(tail[:inner]):
            self._addstr(self.w_log, i + 1, 2, line[:W - 4])

        self.w_log.noutrefresh()

    def _draw_bar(self):
        _, W = self.w_bar.getmaxyx()
        with self.lock:
            status = self.status
        busy = " ⟳" if self.busy else ""
        msg  = f"  dotdeps  ·  {DISTRO}  ·  {status}{busy}"
        self._addstr(self.w_bar, 0, 0, msg[:W - 1].ljust(W - 1),
                     curses.color_pair(C_YELLOW) | curses.A_BOLD)
        self.w_bar.noutrefresh()

    def _draw_help(self):
        _, W = self.w_help.getmaxyx()
        self._addstr(self.w_help, 0, 0, HELP[:W - 1], curses.color_pair(C_CYAN))
        self.w_help.noutrefresh()

    def draw(self):
        self._draw_cats()
        self._draw_items()
        self._draw_log()
        self._draw_bar()
        self._draw_help()
        curses.doupdate()

    # ── modal helpers ─────────────────────────────────────────────────────────

    def _run_modal(self, modal: Modal) -> dict | None:
        """Run a Modal with blocking input, restore non-blocking after."""
        self.scr.nodelay(False)
        result = modal.run()
        self.scr.nodelay(True)
        self.scr.clear()
        return result

    def _confirm(self, msg: str, danger=True) -> bool:
        """Inline yes/no dialog. Defaults to No."""
        H, W = self.scr.getmaxyx()
        w  = min(W - 6, max(len(msg) + 8, 44))
        h  = 6
        y  = max(1, (H - h) // 2)
        x  = max(1, (W - w) // 2)
        win = curses.newwin(h, w, y, x)
        sel = False  # False=No (default), True=Yes

        self.scr.nodelay(False)
        try:
            while True:
                win.erase()
                bc = curses.color_pair(C_RED if danger else C_BORDER)
                win.attron(bc); win.box(); win.attroff(bc)
                win.addstr(0, 2, " Confirm ", bc | curses.A_BOLD)
                try:
                    win.addstr(2, 2, msg[:w - 4])
                except curses.error:
                    pass
                mid = w // 2
                yes_a = (curses.color_pair(C_SEL) | curses.A_BOLD) if sel else curses.color_pair(C_RED)
                no_a  = (curses.color_pair(C_SEL) | curses.A_BOLD) if not sel else 0
                try:
                    win.addstr(4, mid - 9, " [Yes] ", yes_a)
                    win.addstr(4, mid + 1, " [No]  ", no_a)
                except curses.error:
                    pass
                win.refresh()

                key = self.scr.getch()
                if key in (ord('y'), ord('Y')):
                    return True
                elif key in (ord('n'), ord('N'), 27):
                    return False
                elif key in (curses.KEY_LEFT, curses.KEY_RIGHT, ord('\t')):
                    sel = not sel
                elif key in (curses.KEY_ENTER, 10, 13):
                    return sel
        finally:
            self.scr.nodelay(True)
            self.scr.clear()

    # ── background jobs ───────────────────────────────────────────────────────

    def _bg(self, fn, *args):
        def wrapper():
            self.busy = True
            try:
                fn(*args)
            finally:
                self.busy = False
        threading.Thread(target=wrapper, daemon=True).start()

    def _load_cats(self):
        with self.lock:
            self.status = "Loading categories…"
        cats = fetch_categories()
        with self.lock:
            self.cats   = cats
            self.items  = []
            self.status = ROOT_DIR
        self._load_items_for_sel()

    def _load_items_for_sel(self):
        with self.lock:
            cats = list(self.cats)
            sel  = self.cat_sel
        if not cats or sel >= len(cats):
            return
        cat_id    = cats[sel]["id"]
        cat_label = cats[sel]["label"]
        with self.lock:
            self.status = f"Checking {cat_label}…"
        items = fetch_items(cat_id)
        with self.lock:
            self.items       = items
            self.item_sel    = 0
            self.item_scroll = 0
            self.status      = ROOT_DIR
        self._load_details_for_sel()

    def _load_details_for_sel(self):
        with self.lock:
            items = list(self.items)
            sel   = self.item_sel
        if not items or sel >= len(items):
            with self.lock:
                self.details  = ""
                self.loglines = []
            return
        item_id = items[sel]["id"]
        details = fetch_details(item_id)
        with self.lock:
            self.details  = details
            self.loglines = []

    def _do_install_item(self, item_id: str):
        log_path = _new_log_path(f"install_{item_id}")
        with self.lock:
            self.loglines = [f"# install: {item_id}", f"# log: {log_path}", ""]
            self.last_log = log_path
            self.status   = f"Installing {item_id}…"

        def log(line):
            with self.lock:
                self.loglines.append(line)

        rc = _bash_stream(f"dep_install_item {shlex.quote(item_id)}", log, log_path)
        result = "✓ Done" if rc == 0 else "✗ Failed"
        with self.lock:
            self.loglines.append(f"\n{result} (exit {rc})")
            self.status = f"{result}: {item_id}  · log: {os.path.basename(log_path)}"
        self._load_items_for_sel()

    def _do_install_cat(self, cat_id: str):
        log_path = _new_log_path(f"install_cat_{cat_id}")
        with self.lock:
            self.loglines = [f"# install category: {cat_id}", f"# log: {log_path}", ""]
            self.last_log = log_path
            self.status   = f"Installing all in {cat_id}…"

        def log(line):
            with self.lock:
                self.loglines.append(line)

        rc = _bash_stream(f"dep_install_category {shlex.quote(cat_id)}", log, log_path)
        result = "✓ Done" if rc == 0 else "✗ Failed"
        with self.lock:
            self.loglines.append(f"\n{result} (exit {rc})")
            self.status = f"{result}: install {cat_id}  · log: {os.path.basename(log_path)}"
        self._load_items_for_sel()

    def _do_stow_cat(self, cat_id: str):
        log_path = _new_log_path(f"stow_{cat_id}")
        with self.lock:
            self.loglines = [f"# stow: {cat_id}", f"# log: {log_path}", ""]
            self.last_log = log_path
            self.status   = f"Stowing {cat_id}…"

        def log(line):
            with self.lock:
                self.loglines.append(line)

        cat_id_q = shlex.quote(cat_id)
        rc = _bash_stream(
            f"pkgs=\"${{DEP_CATEGORY_STOW[{cat_id_q}]}}\"; dep_stow_packages \"$pkgs\"",
            log, log_path,
        )
        result = "✓ Done" if rc == 0 else "✗ Failed"
        with self.lock:
            self.loglines.append(f"\n{result} (exit {rc})")
            self.status = f"{result}: stow {cat_id}  · log: {os.path.basename(log_path)}"

    def _open_logs_dir(self):
        try:
            files = sorted(os.listdir(LOG_DIR), reverse=True)[:30]
        except FileNotFoundError:
            files = []
        lines = [f"Logs in {LOG_DIR}:", ""] + (files if files else ["(no logs yet)"])
        with self.lock:
            self.loglines = lines
            self.last_log = ""

    # ── add / edit / delete ───────────────────────────────────────────────────

    def _add_category(self):
        fields = [
            ("id",    "id",    "lowercase, no spaces"),
            ("label", "label", "display name"),
            ("stow",  "stow",  "space-separated stow packages, or blank"),
        ]
        vals = self._run_modal(Modal(self.scr, "Add category", fields))
        if not vals or not vals["id"]:
            return
        cat_id = vals["id"].lower().replace(" ", "_")
        _catalog_append(f"\n{_make_cat_line(cat_id, vals['label'], vals['stow'])}")
        with self.lock:
            self.status = f"✓ Added category '{cat_id}'"
        self._bg(self._load_cats)

    def _edit_category(self, cat_id: str):
        raw = fetch_raw_category(cat_id)
        fields = [
            ("label", "label", "display name"),
            ("stow",  "stow",  "space-separated stow packages, or blank"),
        ]
        vals = self._run_modal(Modal(self.scr, f"Edit category  {cat_id}", fields, raw))
        if not vals:
            return
        idx = _catalog_find_cat(cat_id)
        if idx == -1:
            with self.lock:
                self.status = f"✗ Could not find category line for '{cat_id}'"
            return
        _catalog_replace(idx, _make_cat_line(cat_id, vals["label"], vals["stow"]))
        with self.lock:
            self.status = f"✓ Updated category '{cat_id}'"
        self._bg(self._load_cats)

    def _delete_category(self, cat_id: str):
        if not self._confirm(f"Delete category '{cat_id}' and ALL its deps?"):
            return
        _catalog_delete_cat(cat_id)
        with self.lock:
            self.status   = f"✓ Deleted category '{cat_id}'"
            self.cat_sel  = max(0, self.cat_sel - 1)
        self._bg(self._load_cats)

    def _add_dep(self, cat_id: str):
        fields = [
            ("id",      "id",      "lowercase, no spaces"),
            ("label",   "label",   "display name"),
            ("kind",    "kind",    "choice:cmd|path|shell|package"),
            ("check",   "check",   "cmd name / path / shell expression"),
            ("install", "install", "bash command  or  apt_pkg|arch_pkg  for package kind"),
            ("note",    "note",    "short description (optional)"),
        ]
        defaults = {"kind": "cmd"}
        vals = self._run_modal(Modal(self.scr, f"Add dep  →  {cat_id}", fields, defaults))
        if not vals or not vals["id"]:
            return
        dep_id = vals["id"].lower().replace(" ", "_")
        _catalog_append(
            f"\n{_make_dep_line(cat_id, dep_id, vals['label'], vals['kind'], vals['check'], vals['install'], vals['note'])}"
        )
        with self.lock:
            self.status = f"✓ Added '{dep_id}' to '{cat_id}'"
        self._bg(self._load_items_for_sel)

    def _edit_dep(self, cat_id: str, dep_id: str):
        raw = fetch_raw_item(dep_id)
        fields = [
            ("label",   "label",   "display name"),
            ("kind",    "kind",    "choice:cmd|path|shell|package"),
            ("check",   "check",   "cmd name / path / shell expression"),
            ("install", "install", "bash command  or  apt_pkg|arch_pkg  for package kind"),
            ("note",    "note",    "short description (optional)"),
        ]
        vals = self._run_modal(Modal(self.scr, f"Edit dep  {dep_id}", fields, raw))
        if not vals:
            return
        idx = _catalog_find_dep(cat_id, dep_id)
        if idx == -1:
            with self.lock:
                self.status = f"✗ Could not find dep line for '{dep_id}'"
            return
        _catalog_replace(
            idx,
            _make_dep_line(cat_id, dep_id, vals["label"], vals["kind"], vals["check"], vals["install"], vals["note"]),
        )
        with self.lock:
            self.status = f"✓ Updated '{dep_id}'"
        self._bg(self._load_items_for_sel)

    def _delete_dep(self, cat_id: str, dep_id: str):
        if not self._confirm(f"Delete dep '{dep_id}' from '{cat_id}'?"):
            return
        _catalog_delete_dep(cat_id, dep_id)
        with self.lock:
            self.status   = f"✓ Deleted '{dep_id}'"
            self.item_sel = max(0, self.item_sel - 1)
        self._bg(self._load_items_for_sel)

    # ── helpers ───────────────────────────────────────────────────────────────

    def _cur_cat_id(self):
        with self.lock:
            cats = list(self.cats)
        return cats[self.cat_sel]["id"] if cats and 0 <= self.cat_sel < len(cats) else None

    def _cur_item_id(self):
        with self.lock:
            items = list(self.items)
        return items[self.item_sel]["id"] if items and 0 <= self.item_sel < len(items) else None

    # ── input ─────────────────────────────────────────────────────────────────

    def handle(self, key) -> bool:
        if key in (ord('q'), ord('Q')):
            return False

        if key == curses.KEY_RESIZE:
            self.scr.clear()
            self._layout()
            return True

        if key == ord('\t'):
            self.focus = 1 - self.focus
            return True

        if key == ord('L'):
            self._open_logs_dir()
            return True

        cat_id  = self._cur_cat_id()
        item_id = self._cur_item_id()

        if self.focus == 0:  # ── categories ──────────────────────────────────
            if key in (ord('j'), curses.KEY_DOWN):
                self.cat_sel += 1
                self._bg(self._load_items_for_sel)
            elif key in (ord('k'), curses.KEY_UP):
                self.cat_sel = max(0, self.cat_sel - 1)
                self._bg(self._load_items_for_sel)
            elif key in (ord('\n'), 10, 13, curses.KEY_ENTER, curses.KEY_RIGHT):
                self.focus = 1
            elif key == ord('r'):
                self._bg(self._load_cats)
            elif key == ord('n'):
                self._add_category()
            elif key == ord('e') and cat_id:
                self._edit_category(cat_id)
            elif key == ord('d') and cat_id:
                self._delete_category(cat_id)
            elif key == ord('a') and cat_id:
                self._bg(self._do_install_cat, cat_id)
            elif key == ord('s') and cat_id:
                self._bg(self._do_stow_cat, cat_id)

        else:  # ── items ───────────────────────────────────────────────────────
            if key in (ord('j'), curses.KEY_DOWN):
                self.item_sel += 1
                self._bg(self._load_details_for_sel)
            elif key in (ord('k'), curses.KEY_UP):
                self.item_sel = max(0, self.item_sel - 1)
                self._bg(self._load_details_for_sel)
            elif key in (27, curses.KEY_LEFT):
                self.focus = 0
            elif key == ord('r'):
                self._bg(self._load_items_for_sel)
            elif key == ord('n') and cat_id:
                self._add_dep(cat_id)
            elif key == ord('e') and cat_id and item_id:
                self._edit_dep(cat_id, item_id)
            elif key == ord('d') and cat_id and item_id:
                self._delete_dep(cat_id, item_id)
            elif key == ord('i') and item_id:
                self._bg(self._do_install_item, item_id)
            elif key == ord('a') and cat_id:
                self._bg(self._do_install_cat, cat_id)
            elif key == ord('s') and cat_id:
                self._bg(self._do_stow_cat, cat_id)

        return True

    # ── main loop ─────────────────────────────────────────────────────────────

    def run(self):
        curses.curs_set(0)
        self.scr.nodelay(True)
        self.scr.keypad(True)

        self._bg(self._load_cats)

        while True:
            self.draw()
            key = self.scr.getch()
            if key == -1:
                curses.napms(50)
                continue
            if not self.handle(key):
                break


# ── entry point ───────────────────────────────────────────────────────────────

def main():
    if not ROOT_DIR:
        sys.exit("dotdeps: could not locate dotfiles root (.git directory)")
    if not CATALOG:
        sys.exit(f"dotdeps: catalog not found (checked ~/.config/dotdeps/catalog.sh and {ROOT_DIR})")

    _pre_flight()
    curses.wrapper(lambda scr: App(scr).run())


if __name__ == "__main__":
    main()
